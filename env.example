# Supabase (Project Settings > API) — use an EU/UK region project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic API (AI coaching assistant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (coach subscription billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Protects the daily risk-scoring cron endpoint
CRON_SECRET=

# Email (https://resend.com) — verify your domain in Resend first
RESEND_API_KEY=
EMAIL_FROM=COACHOS <notifications@yourdomain.com>

# Safety cap on AI analyses per coach per 24 hours
AI_DAILY_LIMIT_PER_COACH=150

# Demo account (npm run seed:demo)
DEMO_PASSWORD=
